{
  // Site statique : pas de Worker, seulement les assets de dist/ (Workers Static Assets).
  // Pas d'account_id ici : le dépôt est public, la CI le lit dans le secret
  // CLOUDFLARE_ACCOUNT_ID (voir ~/dev/CLOUDFLARE.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pavlotrinko",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Les URL finissent par « / » (trailingSlash: 'always' dans astro.config.ts) :
    // /fr/posts/x/ sert dist/fr/posts/x/index.html, /fr/posts/x redirige.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Domaine personnalisé sur la zone pavlotrinko.com (compte Perso) ; wrangler
  // crée l'enregistrement DNS. L'adresse *.workers.dev est coupée pour éviter
  // un doublon du site.
  "routes": [{ "pattern": "pavlotrinko.com", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true }
}
