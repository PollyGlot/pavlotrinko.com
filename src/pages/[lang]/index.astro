---
import EntryList from '../../components/EntryList.astro'
import SocialLinks from '../../components/SocialLinks.astro'
import type { Locale } from '../../i18n/locales'
import { useTranslations } from '../../i18n/ui'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { entrySlug, getNotes, getPosts, getProjects } from '../../lib/content'
import { localeStaticPaths, localeUrl } from '../../lib/paths'

export const getStaticPaths = localeStaticPaths

const lang = Astro.params.lang as Locale
const t = useTranslations(lang)
const projects = await getProjects(lang)
const posts = (await getPosts(lang)).slice(0, 5)
const notes = (await getNotes(lang)).slice(0, 5)
---

<BaseLayout lang={lang} path="">
  <div class="intro">
    <!-- La rature est le seul ornement du site : <del>/<ins> pour que la
         correction se lise aussi sans les styles. -->
    <h1 class="headline">
      {t('home.headlineStart')}{' '}
      <span class="correction"><del>{t('home.headlineOld')}</del><ins> {t('home.headlineNew')}</ins></span>{
        t('home.headlineEnd')
      }
      <span class="headline-second">{t('home.headlineSecond')}</span>
    </h1>
    <p class="lead">{t('home.intro')}</p>
    <SocialLinks lang={lang} />
  </div>

  <section class="section">
    <h2><a href={localeUrl(lang, 'projects/')}>{t('nav.projects')}</a></h2>
    <ul class="entry-list">
      {
        projects.map((p) => (
          <li>
            <a href={localeUrl(lang, 'projects/')}>
              <span class="entry-title">{p.data.title}</span>
              {p.data.placeholder && <span class="badge">{t('projects.placeholder')}</span>}
            </a>
            <p>{p.data.summary}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2><a href={localeUrl(lang, 'notes/')}>{t('nav.notes')}</a></h2>
    <EntryList
      lang={lang}
      empty={t('notes.empty')}
      compact
      items={notes.map((n) => ({ href: `notes/${entrySlug(n)}/`, prefix: `#${n.data.number}`, ...n.data }))}
    />
  </section>

  <section class="section">
    <h2><a href={localeUrl(lang, 'posts/')}>{t('nav.posts')}</a></h2>
    <EntryList
      lang={lang}
      empty={t('posts.empty')}
      compact
      items={posts.map((p) => ({ href: `posts/${entrySlug(p)}/`, ...p.data }))}
    />
  </section>
</BaseLayout>
