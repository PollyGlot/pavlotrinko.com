---
import { render } from 'astro:content'
import type { Locale } from '../../i18n/locales'
import { useTranslations } from '../../i18n/ui'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getProjects } from '../../lib/content'
import { localeStaticPaths } from '../../lib/paths'

export const getStaticPaths = localeStaticPaths

const lang = Astro.params.lang as Locale
const t = useTranslations(lang)
const projects = await Promise.all(
  (await getProjects(lang)).map(async (project) => ({
    ...project.data,
    Content: (await render(project)).Content,
  })),
)
---

<BaseLayout lang={lang} title={t('projects.title')} path="projects/">
  <h1>{t('projects.title')}</h1>
  <ul class="project-list">
    {
      projects.map(({ title, summary, placeholder, url, repo, Content }) => (
        <li>
          <h2>{title}</h2>
          {placeholder && <p class="badge">{t('projects.placeholder')}</p>}
          <p>{summary}</p>
          <Content />
          {(url || repo) && (
            <p>
              {url && <a href={url}>{url}</a>}
              {url && repo && ' · '}
              {repo && <a href={repo}>{repo}</a>}
            </p>
          )}
        </li>
      ))
    }
  </ul>
</BaseLayout>
