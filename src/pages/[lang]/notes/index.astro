---
import EntryList from '../../../components/EntryList.astro'
import type { Locale } from '../../../i18n/locales'
import { useTranslations } from '../../../i18n/ui'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { entrySlug, getNotes } from '../../../lib/content'
import { localeStaticPaths } from '../../../lib/paths'

export const getStaticPaths = localeStaticPaths

const lang = Astro.params.lang as Locale
const t = useTranslations(lang)
const notes = await getNotes(lang)
---

<BaseLayout lang={lang} title={t('notes.title')} path="notes/">
  <h1>{t('notes.title')}</h1>
  <EntryList
    lang={lang}
    empty={t('notes.empty')}
    items={notes.map((n) => ({ href: `notes/${entrySlug(n)}/`, prefix: `#${n.data.number}`, ...n.data }))}
  />
</BaseLayout>
