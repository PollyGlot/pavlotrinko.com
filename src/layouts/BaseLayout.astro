---
import BaseHead from '../components/BaseHead.astro'
import LanguageSwitcher from '../components/LanguageSwitcher.astro'
import SocialLinks from '../components/SocialLinks.astro'
import { type Locale, locales } from '../i18n/locales'
import { useTranslations } from '../i18n/ui'
import { feedUrl, localeUrl } from '../lib/paths'
import { site } from '../site'

interface Props {
  lang: Locale
  // Titre de la page ; absent sur l'accueil, qui porte le nom du site seul.
  title?: string
  description?: string
  path: string
  available?: readonly Locale[]
  type?: 'website' | 'article'
  noindex?: boolean
}

const { lang, title, description, path, available = locales, type = 'website', noindex = false } = Astro.props
const t = useTranslations(lang)
const fullTitle = title ? `${title} · ${t('site.title')}` : t('site.title')
const nav = [
  { path: 'projects/', label: t('nav.projects') },
  { path: 'posts/', label: t('nav.posts') },
  { path: 'notes/', label: t('nav.notes') },
  { path: 'contact/', label: t('nav.contact') },
]
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead
      lang={lang}
      title={fullTitle}
      description={description ?? t('site.description')}
      path={path}
      available={available}
      type={type}
      noindex={noindex}
    />
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <!-- Le point rouge après le nom : la seule couleur de l'en-tête. -->
        <a href={localeUrl(lang)} class="site-name">{site.author}<span class="mark">.</span></a>
        <div class="site-nav">
          <nav aria-label={t('nav.main')}>
            <ul>
              {nav.map((item) => (
                <li>
                  <a href={localeUrl(lang, item.path)} aria-current={path.startsWith(item.path) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <LanguageSwitcher lang={lang} path={path} available={available} />
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>
          {t('contact.cta')} <a href={localeUrl(lang, 'contact/')}>{t('footer.contact')}</a>
        </p>
        <SocialLinks lang={lang} />
        <p class="meta">
          {site.author} · {site.handle} · <a href={feedUrl(lang)}>{t('footer.rss')}</a>
        </p>
      </footer>
    </div>
  </body>
</html>
