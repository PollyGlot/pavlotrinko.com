---
import type { Locale } from '../i18n/locales'
import { formatDate, localeUrl } from '../lib/paths'

interface Props {
  lang: Locale
  items: { href: string; title: string; description: string; date: Date; prefix?: string }[]
  empty: string
  // Une ligne par entrée, sans description : les listes de l'accueil.
  compact?: boolean
}

const { lang, items, empty, compact = false } = Astro.props
---

{
  items.length === 0 ? (
    <p class="meta">{empty}</p>
  ) : (
    <ul class:list={['entry-list', { compact }]}>
      {items.map((item) => (
        <li>
          <a href={localeUrl(lang, item.href)}>
            {item.prefix && <span class="entry-prefix">{item.prefix}</span>}
            <span class="entry-title">{item.title}</span>
          </a>
          <time datetime={item.date.toISOString()}>{formatDate(item.date, lang)}</time>
          {!compact && <p>{item.description}</p>}
        </li>
      ))}
    </ul>
  )
}
